# RAG系统配置示例
# 将此文件复制为 model_config.yaml 并根据你的环境进行配置
# 注意：model_config.yaml 已被添加到 .gitignore，不会被上传到仓库

# 数据源配置
data_sources:
  obsidian_vault_path: "/Users/yourname/Library/Mobile Documents/iCloud~md~obsidian/Documents/YourVault"
  
  # PDF教材路径 (如果存在)
  pdf_paths: []
    # - "/path/to/textbook1.pdf"
    # - "/path/to/textbook2.pdf"

# 嵌入模型配置
embedding:
  model_name: "BAAI/bge-small-zh-v1.5"
  model_type: "sentence-transformers"
  device: "cpu"  # cpu or cuda
  normalize_embeddings: true
  batch_size: 32

# 分块策略配置
chunking:
  # 层次化分块策略
  strategies:
    small:
      chunk_size: 256  # 词元数
      chunk_overlap: 64
      use_for: "精确检索"
    
    medium:
      chunk_size: 512
      chunk_overlap: 128
      use_for: "上下文理解"
    
    large:
      chunk_size: 1024
      chunk_overlap: 256
      use_for: "关系提取"
  
  # 语义边界
  semantic_boundaries:
    - "## "  # 二级标题
    - "### " # 三级标题
    - "\n\n" # 段落分隔

# 向量数据库配置
vector_store:
  type: "chroma"
  persist_directory: "./data/embeddings/chroma"
  collection_name: "obsidian_notes"
  
  # 检索参数
  retrieval:
    top_k: 10  # 初始检索数量
    score_threshold: 0.5  # 相似度阈值

# LLM配置 (包含隐私信息 - 不提交到仓库)
llm:
  # 本地模式 (LM Studio) - 配置你的实际服务器地址
  local:
    enabled: true
    base_url: "http://YOUR_SERVER_IP:1234"  # 替换为实际的服务器地址
    model: "your-model-name"  # 从LM Studio API获取的实际模型名称
    temperature: 0.1
    timeout: 500
    max_tokens: 1024
  
  # 云API模式
  cloud:
    enabled: false
    provider: "deepseek"  # deepseek, openai, etc.
    api_key: "YOUR_API_KEY_HERE"  # 替换为实际的API密钥
    model: "deepseek-chat"
    temperature: 0.1
    max_tokens: 1024

# 检索增强配置
retrieval_enhancement:
  # 混合搜索权重
  hybrid_search:
    vector_weight: 0.7
    keyword_weight: 0.3
  
  # 查询扩展
  query_expansion:
    enabled: true
    synonyms: true
    technical_terms: true
  
  # 结果重排序
  reranking:
    enabled: false  # 初始版本关闭
    model: "cross-encoder/ms-marco-MiniLM-L-6-v2"

# 系统性能
performance:
  cache_embeddings: true
  parallel_processing: true
  max_workers: 4

# 日志配置
logging:
  level: "INFO"
  file: "./logs/rag_system.log"
  console: true
